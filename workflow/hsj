  padding-top: 10px;
}

.info p {
  padding-bottom: 10px;
  padding-left: 10px;
  transition: padding-bottom 0.3s ease;
}

.card:hover .info {
  opacity: 1.0;
}

.card:hover .info p {
  padding-bottom: 20px;
  margin-bottom: 10px;
}

